# Copy this file to .env and fill in the gateway(s) you want. Restart `python app.py` after changes.
# Leave a gateway's keys empty to hide it. Never commit .env.

# Currency charged by the gateways. TMS invoices are in USD; PAYMENT_FX_RATE converts
# (e.g. PAYMENT_CURRENCY=INR and PAYMENT_FX_RATE=83.2 for Indian Razorpay accounts).
PAYMENT_CURRENCY=USD
PAYMENT_FX_RATE=1

# ---- PayPal: https://developer.paypal.com/dashboard/applications  (Apps & Credentials)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id from the app's Webhooks section (URL: https://<your-host>/api/webhooks/paypal,
# events: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED)
PAYPAL_WEBHOOK_ID=
PAYPAL_BRAND_NAME=FleetFlow TMS

# ---- Razorpay: https://dashboard.razorpay.com/app/website-app-settings/api-keys  (use Test Mode keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: secret you set when adding a webhook (URL: https://<your-host>/api/webhooks/razorpay,
# events: payment.authorized, payment.captured, payment.failed, order.paid)
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MERCHANT_NAME=FleetFlow TMS
